PORT=4000

# Supabase (for persisting tracking data)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PCS 1x (Indian port events)
PCS_API_KEY=
PCS_API_URL=https://api.pcs1x.com/v1

# Redis (optional - for distributed cache)
REDIS_URL=

# Playwright browser path (optional - defaults to system Chromium)
PLAYWRIGHT_BROWSER_PATH=

# Proxy (optional - for rotating IPs during scraping)
PROXY_URL=
